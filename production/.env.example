# FlowSync Customer Success AI Agent -- Environment Variables
# =============================================================
# Copy this file: cp .env.example .env
# Fill in your actual values.
#
# NEVER commit .env to version control!

# ──────────────────────────────────────────────────────────────
# LLM Provider (Optional — app works without it via rule-based engine)
# Set GROQ_API_KEY or OPENAI_API_KEY for AI-powered responses.
# ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────────────────────────
# PostgreSQL (Optional — falls back to in-memory)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────────────────
# Kafka (Optional — falls back to direct processing)
# ──────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP=flowsync-message-processor

# ──────────────────────────────────────────────────────────────
# SMTP (Email replies — optional, without it replies return via API)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=support@flowsync.com

# ──────────────────────────────────────────────────────────────
# Twilio (WhatsApp replies — optional)
# ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_ENV=development

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ──────────────────────────────────────────────────────────────
# CORS (for local dev)
# ──────────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]
